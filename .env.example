# ============================================================
# ARCHIVO DE EJEMPLO — copiar a .env y completar los valores
# NUNCA guardar valores reales en este archivo ni en git
# ============================================================

# ── BASE DE DATOS ────────────────────────────────────────────
# URL completa de conexión a PostgreSQL (usada por Prisma y la app)
DATABASE_URL="postgresql://cruzblanca:CAMBIA_ESTA_CONTRASEÑA@db:5432/cruzblanca"

# Credenciales del contenedor PostgreSQL
POSTGRES_USER=cruzblanca
POSTGRES_PASSWORD=CAMBIA_ESTA_CONTRASEÑA
POSTGRES_DB=cruzblanca

# ── AUTH.JS ──────────────────────────────────────────────────
# Secreto para firmar JWT — mínimo 32 bytes aleatorios en hex
# Generar con: openssl rand -hex 32
AUTH_SECRET=CAMBIA_POR_32_BYTES_HEX_ALEATORIOS

# URL base de la app (importante para cookies y redirects)
NEXTAUTH_URL=http://localhost:3000

# ── CIFRADO DE CAMPOS SENSIBLES ──────────────────────────────
# Clave AES-256-GCM para cifrar DNI/NIE, NAF, teléfono
# Generar con: openssl rand -hex 32
FIELD_ENCRYPTION_KEY=CAMBIA_POR_32_BYTES_HEX_ALEATORIOS

# Clave HMAC-SHA256 para hashes de búsqueda (distinta de la anterior)
# Generar con: openssl rand -hex 32
SEARCH_HMAC_KEY=CAMBIA_POR_32_BYTES_HEX_ALEATORIOS

# ── ALMACENAMIENTO ───────────────────────────────────────────
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=/app/data/documents

# ── RUTAS EN PRODUCCIÓN (D:\CruzBlancaDatos\) ───────────────
# Solo necesarias con docker-compose.prod.yml
# PGDATA_PATH=D:\CruzBlancaDatos\postgres
# DOCUMENTS_PATH=D:\CruzBlancaDatos\documents
# BACKUP_PATH=D:\CruzBlancaBackups

# ── APLICACIÓN ───────────────────────────────────────────────
NODE_ENV=development
TZ=Europe/Madrid
LOG_LEVEL=info
MAX_UPLOAD_SIZE_MB=20
APP_PORT=3000

# ── ANTHROPIC (OCR de facturas) ──────────────────────────────
# Obtener en https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-CAMBIA_POR_TU_API_KEY
